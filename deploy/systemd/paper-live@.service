[Unit]
Description=Paper-live trading engine for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperlive
WorkingDirectory=/opt/trading-engine
EnvironmentFile=/etc/paper-live/env
Environment=PAPER_LIVE_JOURNAL_DIR=/var/log/paper-live/journal
# Strategy A (P4-Combined) with mh504 (21d max-hold) + 3 shadow strategies.
# Pre-registered validation history:
#   - 2026-05-06: mh504 wins 6/6 vs mh336 → STRONG → adopted as live config
#   - 2026-05-06: 5/15 EMA wins 4/6 vs 9/21 → WEAK → run as shadow for forward validation
#   - 2026-05-07: BB(20, 2.0) Cat A WEAK literal + D2 Sharpe SUPPORTIVE (+81% Sharpe,
#     +63% sum vs baseline) → added as shadow. NOT a parameter variant — entirely
#     different entry mechanism (Bollinger breakdown vs EMA cross), shorts-only.
# Shadow strategies receive identical market data but write to separate journals
# at /var/log/paper-live/journal/shadow/<label>/. Compare live vs shadow PnL
# after sufficient forward time accumulates.
# Rollback: drop --shadow flag (live unaffected); change --max-hold-hours 504 → 336.
#
# Executor mode: stub (paper-money — DEFAULT). For STAGE_1+ promotion to
# real-money, see real_money_executor_architecture_decision_rule_2026-05-08.md
# + stage_promotion_runbook_decision_rule_2026-05-08.md. The locked workflow:
#
#   1. Pre-flight: Layer 2 testnet integration tests pass + Layer 3 7-day
#      shadow-mode parity diff ≤0.5% pnl_usd per closed trade.
#   2. Add to /etc/paper-live/env (loaded via EnvironmentFile above):
#        BINANCE_API_KEY=<production_key>
#        BINANCE_API_SECRET=<production_secret>
#   3. Promote ONE symbol first (per stage_promotion_runbook). Override its
#      unit via `systemctl edit paper-live@<sym>.service` and ADD to ExecStart:
#        --executor binance_live
#      The drop-in override doesn't touch this template — other symbols stay
#      on stub. STAGE_1 stake is $100/trade — also adjust the per-symbol
#      configs/<sym>.yaml stake_usdt: 100 before the override redeploy.
#   4. systemctl daemon-reload && systemctl restart paper-live@<sym>.service
#   5. RecoverFromJournal verifies recovered state against exchange; on
#      divergence the engine refuses to start (os.Exit(2)) with CRITICAL
#      Telegram alert — operator must reconcile per the locked rule.
#   6. After 30d clean drift detector at STAGE_1 → STAGE_2 (per
#      real_money_protocol_decision_rule_2026-05-08.md). Repeat per-stage.
#
# IMPORTANT: Shadow runners ALWAYS use stub regardless of --executor. Real
# money goes to ONE strategy at a time per the locked rule.
ExecStart=/opt/trading-engine/bin/engine --config /opt/trading-engine/configs/%i.yaml \
    --signal-tf 4H --target-rr 6.0 \
    --side-filter short \
    --funding-csv-dir /opt/trading-engine/data/funding \
    --fee-bps 10 --stop-slippage-bps 5 --funding-bps-per-day 0 \
    --max-hold-hours 504 \
    --shadow alt5-15-336:5-15-336,alt5-15-504:5-15-504,bb20:bb:20-2.0-504
StandardOutput=append:/var/log/paper-live/%i.log
StandardError=append:/var/log/paper-live/%i.log
Restart=always
RestartSec=10

[Install]
WantedBy=paper-live.target
