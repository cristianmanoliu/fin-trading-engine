[Unit]
Description=Layer 2 testnet engine (BTCUSDT) — real prices, fake fills
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperlive
WorkingDirectory=/opt/trading-engine
EnvironmentFile=/etc/paper-live/env
EnvironmentFile=/etc/paper-live/testnet-env
Environment=PAPER_LIVE_JOURNAL_DIR=/var/log/paper-live/journal/testnet
ExecStart=/opt/trading-engine/bin/engine --config /opt/trading-engine/configs/btcusdt.yaml \
    --executor binance_live_testnet \
    --signal-tf 4H --target-rr 6.0 \
    --side-filter short \
    --funding-csv-dir /opt/trading-engine/data/funding \
    --fee-bps 10 --stop-slippage-bps 5 --funding-bps-per-day 0 \
    --max-hold-hours 504
StandardOutput=append:/var/log/paper-live/testnet-btcusdt.log
StandardError=append:/var/log/paper-live/testnet-btcusdt.log
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
